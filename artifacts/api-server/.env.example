# Required by the base server (see src/index.ts)
PORT=8080

# --- Request More Info (OTP document delivery) ---

# Secret key used to HMAC OTP codes before they're stored. Generate a real
# random value for every environment, e.g.: openssl rand -hex 32
OTP_HASH_SECRET=

# Minutes before an issued OTP expires.
REQUEST_INFO_OTP_TTL_MINUTES=10

# Failed verification attempts allowed per OTP challenge before it is invalidated.
REQUEST_INFO_MAX_ATTEMPTS=5

# "console" (default) logs emails instead of sending them - safe for local
# development, never used in production. Set to "resend" to send real email.
MAIL_PROVIDER=console

# Required when MAIL_PROVIDER=resend.
RESEND_API_KEY=

# The official production sender for both the OTP verification email and
# the document-delivery email. MAIL_FROM_EMAIL is required when
# MAIL_PROVIDER=resend, and its domain (dcl-consulting-group.com) must be
# verified in the Resend account or every send will fail. Outgoing mail is
# also sent with Reply-To set to this same address, so a recipient hitting
# "Reply" reaches DCL directly.
MAIL_FROM_EMAIL=info@dcl-consulting-group.com
MAIL_FROM_NAME=DCL Consulting and Investments Limited

# Used to build absolute asset URLs (e.g. the logo) inside emails.
PUBLIC_SITE_URL=https://dcl-consulting-group.com

# Where the OTP challenge JSON file is written. Unset (local dev) falls
# back to ".data" inside this package. In production, point this at a
# mounted persistent disk - e.g. Render's Persistent Disk mounted at
# /var/data - so pending OTP challenges survive redeploys/restarts. Do
# NOT leave this unset on a host with an ephemeral filesystem.
REQUEST_INFO_DATA_DIR=

# --- CORS ---

# Comma-separated list of origins allowed to call this API (e.g.
# "https://dcl-consulting-group.com,https://dcl-frontend.onrender.com").
# Required in production - the server refuses to boot without it, rather
# than silently allow every origin. Unset outside production (local dev)
# keeps CORS wide open, matching the existing Vite dev-server proxy setup.
CORS_ALLOWED_ORIGINS=
